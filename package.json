{
  "name": "starlight-tarot",
  "private": true,
  "version": "1.0.0",
  "description": "별빛서가 — 너의 내일을 펼치다. 중학교 축제 부스용 한국어 타로 웹앱 (Cloudflare Workers + Gemini)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.ts",
    "cards:import": "node scripts/import-cards.ts",
    "check:assets": "node scripts/check-assets.ts",
    "check:secrets": "node scripts/check-secrets.ts",
    "hash-password": "node scripts/hash-password.ts",
    "setup:local": "node scripts/setup-local.ts",
    "secrets:upload": "node scripts/upload-secrets.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:secrets"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^24.19.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "@fontsource/gowun-batang": "^5.3.0",
    "pretendard": "^1.3.9"
  },
  "allowScripts": {
    "workerd@1.20260926.1": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.4": true,
    "sharp@0.34.5": true
  }
}
